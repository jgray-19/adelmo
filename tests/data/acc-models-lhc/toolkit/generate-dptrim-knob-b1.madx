ADD2EXPR, var=acbch8.r8b1, expr=-4.44e-06*dp_trim.b1;
ADD2EXPR, var=acbch10.r8b1, expr=-1.832e-05*dp_trim.b1;
ADD2EXPR, var=acbh12.r8b1, expr=-1.797e-05*dp_trim.b1;
ADD2EXPR, var=acbh14.r8b1, expr=-2.382e-05*dp_trim.b1;
ADD2EXPR, var=acbh16.r8b1, expr=-2.237e-05*dp_trim.b1;
ADD2EXPR, var=acbh18.r8b1, expr=-2.153e-05*dp_trim.b1;
ADD2EXPR, var=acbh20.r8b1, expr=-2.2879999999999998e-05*dp_trim.b1;
ADD2EXPR, var=acbh22.r8b1, expr=-2.0339999999999995e-05*dp_trim.b1;
ADD2EXPR, var=acbh24.r8b1, expr=-2.043e-05*dp_trim.b1;
ADD2EXPR, var=acbh26.r8b1, expr=-2.141e-05*dp_trim.b1;
ADD2EXPR, var=acbh28.r8b1, expr=-1.997e-05*dp_trim.b1;
ADD2EXPR, var=acbh30.r8b1, expr=-2.185e-05*dp_trim.b1;
ADD2EXPR, var=acbh32.r8b1, expr=-2.2499999999999998e-05*dp_trim.b1;

use, sequence=lhcb1;
create,table=temptwiss_dp_b1,column=name,s,betx,bety,K1L;
twiss,table=temptwiss_dp_b1;
len = table(temptwiss_dp_b1,tablelength);
i = 1;
s_betx = 0;
s_bety = 0;
WHILE (i < len) {
SETVARS,TABLE=temptwiss_dp_b1,ROW=i;
s_betx = s_betx + betx*K1L;
s_bety = s_bety + bety*K1L;
i = i + 1;
};
delete,table=temptwiss_dp_b1;
natural_x = 0.895 * 1e-3 * s_betx/(4*pi);    ! 0.895 and 1.162 are experimentally determined
natural_y = 1.162 * 1e-3 * (-s_bety)/(4*pi); ! to match the natural chroma at injection


! Q compensation
create, table=tuneknobs_b1, column=KQTF.A12B1,KQTF.A23B1,KQTF.A34B1,KQTF.A45B1,KQTF.A56B1,KQTF.A67B1,KQTF.A78B1,KQTF.A81B1,KQTD.A12B1,KQTD.A23B1,KQTD.A34B1,KQTD.A45B1,KQTD.A56B1,KQTD.A67B1,KQTD.A78B1,KQTD.A81B1;
fill_knob,table=tuneknobs_b1,row=1,knob=dQx.b1,scale=natural_x;
fill_knob,table=tuneknobs_b1,row=2,knob=dQy.b1,scale=natural_y;
setvars_knob,table=tuneknobs_b1,row=1,knob=dp_trim.b1;
setvars_knob,table=tuneknobs_b1,row=2,knob=dp_trim.b1;
write,table=tuneknobs_b1;
delete,table=tuneknobs_b1;
