ADD2EXPR, var=acbyh4.l8b2, expr=1.6900000000000001e-06*dp_trim.b2;
ADD2EXPR, var=acbyhs4.r8b2, expr=1.7599999999999997e-06*dp_trim.b2;
ADD2EXPR, var=acbyh5.r8b2, expr=4.52e-06*dp_trim.b2;
ADD2EXPR, var=acbch7.r8b2, expr=-1.61e-06*dp_trim.b2;
ADD2EXPR, var=acbch9.r8b2, expr=-2.9099999999999997e-06*dp_trim.b2;
ADD2EXPR, var=acbh11.r8b2, expr=-1.7e-05*dp_trim.b2;
ADD2EXPR, var=acbh13.r8b2, expr=-2.0150000000000002e-05*dp_trim.b2;
ADD2EXPR, var=acbh15.r8b2, expr=-2.641e-05*dp_trim.b2;
ADD2EXPR, var=acbh17.r8b2, expr=-2.334e-05*dp_trim.b2;
ADD2EXPR, var=acbh19.r8b2, expr=-2.3469999999999997e-05*dp_trim.b2;
ADD2EXPR, var=acbh21.r8b2, expr=-2.3429999999999998e-05*dp_trim.b2;
ADD2EXPR, var=acbh23.r8b2, expr=-2.0979999999999996e-05*dp_trim.b2;
ADD2EXPR, var=acbh25.r8b2, expr=-2.245e-05*dp_trim.b2;
ADD2EXPR, var=acbh27.r8b2, expr=-2.2309999999999998e-05*dp_trim.b2;
ADD2EXPR, var=acbh29.r8b2, expr=-2.205e-05*dp_trim.b2;
ADD2EXPR, var=acbh31.r8b2, expr=-2.419e-05*dp_trim.b2;
ADD2EXPR, var=acbh33.r8b2, expr=-2.309e-05*dp_trim.b2;

use, sequence=lhcb2;
create,table=temptwiss_dp_b2,column=name,s,betx,bety,K1L;
twiss,table=temptwiss_dp_b2;
len = table(temptwiss_dp_b2,tablelength);
i = 1;
s_betx = 0;
s_bety = 0;
WHILE (i < len) {
SETVARS,TABLE=temptwiss_dp_b2,ROW=i;
s_betx = s_betx + betx*K1L;
s_bety = s_bety + bety*K1L;
i = i + 1;
};
delete,table=temptwiss_dp_b2;
natural_x = 0.895 * 1e-3 * s_betx/(4*pi);    ! 0.895 and 1.162 are experimentally determined
natural_y = 1.162 * 1e-3 * (-s_bety)/(4*pi); ! to match the natural chroma at injection

! Q compensation
create, table=tuneknobs_b2, column=KQTF.A12B2,KQTF.A23B2,KQTF.A34B2,KQTF.A45B2,KQTF.A56B2,KQTF.A67B2,KQTF.A78B2,KQTF.A81B2,KQTD.A12B2,KQTD.A23B2,KQTD.A34B2,KQTD.A45B2,KQTD.A56B2,KQTD.A67B2,KQTD.A78B2,KQTD.A81B2;
fill_knob,table=tuneknobs_b2,row=1,knob=dQx.b2,scale=natural_x;
fill_knob,table=tuneknobs_b2,row=2,knob=dQy.b2,scale=natural_y;
setvars_knob,table=tuneknobs_b2,row=1,knob=dp_trim.b2;
setvars_knob,table=tuneknobs_b2,row=2,knob=dp_trim.b2;
delete,table=tuneknobs_b2;
